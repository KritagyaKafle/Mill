---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Thank You Oil Mill", 
  description = "Premium traditional mustard oil from Thank You Company Pvt. Ltd., locally pressed in Kusunti, Lalitpur." 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Thank You Company Pvt. Ltd.",
  "alternateName": "Thank You Oil Mill",
  "image": "https://thankyouoilmill.com/images/logo.webp",
  "telephone": ["+9779845535198", "+9779851349233"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kusunti 13",
    "addressLocality": "Lalitpur",
    "addressCountry": "NP"
  },
  "url": "https://thankyouoilmill.com"
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/logo.webp', Astro.site)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[var(--color-paper-ivory)] text-[var(--color-charcoal)] font-body antialiased selection:bg-[var(--color-mustard-gold-light)] selection:text-[var(--color-charcoal)]">
    <slot />
  </body>
</html>
